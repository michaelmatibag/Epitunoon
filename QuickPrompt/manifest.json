{
  "manifest_version": 3,
  "name": "QuickPrompt – Prompt Library for Claude & ChatGPT",
  "version": "1.0.0",
  "description": "Save your best prompts. Type // anywhere in Claude or ChatGPT to instantly insert them.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "shared/storage.js",
        "content/prompt_picker.js",
        "content/injector.js"
      ],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "QuickPrompt"
  }
}
