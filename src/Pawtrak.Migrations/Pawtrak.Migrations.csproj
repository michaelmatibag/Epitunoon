<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pawtrak.Migrations</RootNamespace>
    <AssemblyName>Pawtrak.Migrations</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DbUp-PostgreSQL" Version="5.0.14" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embed all SQL scripts so DbUp can discover them from the assembly -->
    <EmbeddedResource Include="Scripts\**\*.sql" />
    <!-- Copy appsettings so the runner can resolve the connection string -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
