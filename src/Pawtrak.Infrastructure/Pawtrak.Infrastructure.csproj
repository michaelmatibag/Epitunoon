<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pawtrak.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pawtrak.Core\Pawtrak.Core.csproj" />
    <ProjectReference Include="..\Pawtrak.Application\Pawtrak.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Data access (PostgreSQL + Dapper) -->
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <!-- Payments -->
    <PackageReference Include="Stripe.net" Version="46.2.1" />
    <!-- File storage -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.21.2" />
    <!-- DI extension -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>
</Project>
